# ─────────────────────────────────────────────
# MedScribe — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# LLM Provider Configuration (Supports OpenRouter, Groq, Ollama)
# Provider options: auto | openrouter | groq | ollama
LLM_PROVIDER=auto

# Option 1: OpenRouter (Active default if key is set)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Option 2: Groq (Ultra-fast cloud inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Ollama (Local private inference)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# Generic override if needed
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Database (SQLite — path relative to backend/ working directory)
DATABASE_URL=sqlite:///./data/medscribe.db

# App settings
DEBUG=false
APP_NAME=MedScribe API
APP_VERSION=1.0.0

# CORS (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:8501,http://dashboard:8501

# Dashboard API URL (used by Streamlit to reach the FastAPI backend)
# Use http://backend:8000 when running in Docker Compose
# Use http://localhost:8000 for local development
API_URL=http://localhost:8000
